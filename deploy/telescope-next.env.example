MONITOR_SITE_PASSWORD_HASH=<bcrypt-hash-generated-once-from-the-site-password>
MONITOR_REMEMBER_ME_KEY=<choose-a-different-long-random-secret-and-keep-it-stable>
# MONITOR_SITE_PASSWORD=<legacy-raw-password-fallback>
# Unified Dashboard, connection, and connection-control configuration.
TELESCOPE_SETTINGS_FILE=/var/lib/telescope-next/settings.json
TELESCOPE_RECENT_EVENT_LIMIT=50
TELESCOPE_INVENTORY_HIGHLIGHT_LIMIT=12
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
SESSION_COOKIE_SECURE=true
