MONITOR_SITE_PASSWORD=<choose-a-strong-password>
# Legacy migration paths; remove after migration to the unified settings file.
TELESCOPE_CONNECTION_FILE=/var/lib/telescope-next/connections.json
TELESCOPE_CONTROL_FILE=/var/lib/telescope-next/connection-control.json
# Unified Dashboard, connection, and connection-control configuration.
TELESCOPE_SETTINGS_FILE=/var/lib/telescope-next/settings.json
TELESCOPE_AUTO_CONNECT=true
TELESCOPE_WSS_TAKEOVER_YIELD_DURATION=2h
TELESCOPE_RECENT_EVENT_LIMIT=50
TELESCOPE_INVENTORY_HIGHLIGHT_LIMIT=12
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8081
SESSION_COOKIE_SECURE=true
